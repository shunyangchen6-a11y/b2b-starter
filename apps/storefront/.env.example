# Medusa backend URL and the public storefront URL.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_WHATSAPP_NUMBER=YOUR_COUNTRY_CODE_AND_NUMBER
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Create this key in Medusa Admin and attach it to the storefront sales channel.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_your_publishable_key

# ISO 3166-1 alpha-2, lowercase default sales region.
NEXT_PUBLIC_DEFAULT_REGION=us

# Generate a unique high-entropy value. Keep it server-side and never commit a real value.
REVALIDATE_SECRET=replace_with_a_long_random_revalidation_secret

# Optional payment settings retained for the upstream starter. Leave unset while payments are not enabled.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Optional canonical URL used by sitemap generation on Vercel.
NEXT_PUBLIC_VERCEL_URL=
