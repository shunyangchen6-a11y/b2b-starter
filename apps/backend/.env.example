# Allowed browser origins. Add every deployed storefront and admin URL.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# Required infrastructure. Use a real PostgreSQL database; Redis is recommended for jobs and caching.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/medusa_b2b_starter
REDIS_URL=redis://localhost:6379

# Generate unique, high-entropy values for every environment. Never commit real values.
JWT_SECRET=replace_with_a_long_random_jwt_secret
COOKIE_SECRET=replace_with_a_long_random_cookie_secret

# Optional database name used by local tooling.
DB_NAME=medusa_b2b_starter

# Temporary Preview-only inventory repair. Leave false everywhere except the
# Medusa Cloud Preview environment whose handle includes `preview` or `pr`.
MEDUSA_PREVIEW_INVENTORY_SYNC_ENABLED=false
